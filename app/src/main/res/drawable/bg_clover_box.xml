<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 바깥 은은한 황금빛 후광 테두리 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#66FFE58A" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- 안쪽 빛나는 크림·옐로우 박스 -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#FFFDF2"
                android:endColor="#FFF3BD"
                android:startColor="#FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#F4C95D" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
