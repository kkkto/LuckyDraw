<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ld_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/cd_clover_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/ld_clover_large" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                style="@style/LD.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />
            <TextView
                android:id="@+id/tvMode"
                style="@style/LD.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_park_ready" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/drivePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/driveHero"
                    android:layout_width="match_parent"
                    android:layout_height="218dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ld_scene_v2" />
                    <ImageView
                        android:id="@+id/tvCarArt"
                        android:layout_width="190dp"
                        android:layout_height="160dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_car_art"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ld_car_fairy_v2" />
                </FrameLayout>
                <LinearLayout
                    android:id="@+id/driveHeadlineCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="-44dp"
                    android:background="@drawable/ld_bg_card"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        style="@style/LD.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="27sp"
                        android:text="@string/drive_headline" />
                    <TextView
                        android:id="@+id/tvParkSubtitle"
                        style="@style/LD.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textSize="17sp"
                        android:text="@string/drive_subhead" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/driveInfoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/ld_bg_soft"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/tvRoad"
                        style="@style/LD.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/drive_road_checking"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvSignal"
                        style="@style/LD.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/drive_signal_preparing" />
                    <TextView
                        android:id="@+id/tvDriveScore"
                        style="@style/LD.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/drive_score_default" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/parkPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/parkHero"
                    android:layout_width="match_parent"
                    android:layout_height="218dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ld_scene_v2" />
                    <ImageView
                        android:id="@+id/tvFairyArt"
                        android:layout_width="180dp"
                        android:layout_height="176dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_fairy_art"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ld_fairy_park_v2" />
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="88dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ld_parking_sign" />
                </FrameLayout>
                <LinearLayout
                    android:id="@+id/parkHeadlineCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="-44dp"
                    android:background="@drawable/ld_bg_card"
                    android:elevation="6dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:id="@+id/tvFortuneTitle"
                        style="@style/LD.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="27sp"
                        android:text="@string/park_title_preparing" />
                    <TextView
                        style="@style/LD.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textSize="17sp"
                        android:text="@string/park_subtitle" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShowFortune"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/sim_park"
                        android:textSize="18sp"
                        android:textColor="@color/ld_button_text"
                        app:backgroundTint="@color/ld_accent" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloverRouteBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/cd_open_routes"
                        android:text="@string/route_panel_title"
                        android:textSize="18sp"
                        android:textColor="@color/ld_text_primary"
                        app:backgroundTint="@color/ld_card_soft" />
                    <TextView
                        android:id="@+id/tvSessionSummary"
                        style="@style/LD.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/park_summary_initial"
                        android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_restart"
                        android:textColor="@color/ld_text_primary"
                        android:visibility="gone"
                        app:backgroundTint="@color/ld_card_soft" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/routePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/routeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="8dp">
                <FrameLayout
                    android:id="@+id/routeHero"
                    android:layout_width="match_parent"
                    android:layout_height="220dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ld_route_banner_v2" />
                    <TextView
                        style="@style/LD.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="30dp"
                        android:padding="12dp"
                        android:textSize="30sp"
                        android:text="@string/route_panel_title" />
                </FrameLayout>
                <LinearLayout
                    android:id="@+id/routeActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRouteBack"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/route_back"
                        android:textSize="17sp"
                        android:textColor="@color/ld_text_primary"
                        app:backgroundTint="@color/ld_card_soft" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRouteRefresh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:layout_marginStart="6dp"
                        android:text="@string/route_refresh"
                        android:textSize="17sp"
                        android:textColor="@color/ld_text_primary"
                        app:backgroundTint="@color/ld_card_soft" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvRouteBasis"
                    style="@style/LD.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="@string/route_panel_subtitle_default" />
            <LinearLayout
                android:id="@+id/routeCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/ld_bg_card"
                android:orientation="vertical"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:background="@drawable/ld_bg_route_thumb"
                        android:clipToOutline="true"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ld_route_coast_v2" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvRouteName1"
                            style="@style/LD.RouteTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/route_name_placeholder" />
                        <TextView
                            android:id="@+id/tvRouteSignal1"
                            style="@style/LD.Muted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/route_signal_placeholder" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvRouteMeta1"
                    style="@style/LD.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/route_meta_placeholder" />
                <TextView
                    android:id="@+id/tvRouteDesc1"
                    style="@style/LD.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/route_desc_placeholder" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRouteGo1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/route_start_button"
                    android:textSize="17sp"
                    android:textColor="@color/ld_button_text"
                    app:backgroundTint="@color/ld_accent" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/routeCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/ld_bg_card"
                android:orientation="vertical"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:background="@drawable/ld_bg_route_thumb"
                        android:clipToOutline="true"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ld_route_forest_v2" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvRouteName2"
                            style="@style/LD.RouteTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/route_name_placeholder" />
                        <TextView
                            android:id="@+id/tvRouteSignal2"
                            style="@style/LD.Muted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/route_signal_placeholder" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvRouteMeta2"
                    style="@style/LD.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/route_meta_placeholder" />
                <TextView
                    android:id="@+id/tvRouteDesc2"
                    style="@style/LD.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/route_desc_placeholder" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRouteGo2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/route_start_button"
                    android:textSize="17sp"
                    android:textColor="@color/ld_button_text"
                    app:backgroundTint="@color/ld_accent" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/routeCard3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/ld_bg_card"
                android:orientation="vertical"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:background="@drawable/ld_bg_route_thumb"
                        android:clipToOutline="true"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ld_route_lake_v2" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvRouteName3"
                            style="@style/LD.RouteTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/route_name_placeholder" />
                        <TextView
                            android:id="@+id/tvRouteSignal3"
                            style="@style/LD.Muted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/route_signal_placeholder" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvRouteMeta3"
                    style="@style/LD.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/route_meta_placeholder" />
                <TextView
                    android:id="@+id/tvRouteDesc3"
                    style="@style/LD.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/route_desc_placeholder" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRouteGo3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/route_start_button"
                    android:textSize="17sp"
                    android:textColor="@color/ld_button_text"
                    app:backgroundTint="@color/ld_accent" />
            </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <TextView
        android:id="@+id/tvSystemStatus"
        style="@style/LD.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/system_status_checking" />

    <LinearLayout
        android:id="@+id/simulationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/simMinorActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimDrive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sim_drive"
                android:textSize="19sp"
                android:textColor="@color/ld_text_primary"
                app:backgroundTint="@color/ld_card_soft" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimBrake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="4dp"
                android:text="@string/sim_brake"
                android:textSize="19sp"
                android:textColor="@color/ld_text_primary"
                app:backgroundTint="@color/ld_card_soft" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimPark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="4dp"
            android:text="@string/sim_park"
            android:textSize="19sp"
            android:textColor="@color/ld_button_text"
            app:backgroundTint="@color/ld_accent" />
    </LinearLayout>
</LinearLayout>
